# ==============================================================================
# UNIKART PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="Unikart Universal Commerce Engine"
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_64_character_hex_key_here_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 1. DATABASE: Supabase PostgreSQL (Mandatory)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL & OTP: Gmail SMTP (Free 500 emails/day)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=UNIKART Security <your_email@gmail.com>

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY: Cashfree Payments (PG - Optional for post-launch)
# ------------------------------------------------------------------------------
CASHFREE_ENVIRONMENT=TEST
CASHFREE_APP_ID=TEST_APP_ID_HERE
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_HERE
CASHFREE_API_VERSION=2023-08-01

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (Comma-separated Vercel frontend URLs)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://unikart-storefront.vercel.app,https://unikart-inventory.vercel.app,http://localhost:5173,http://localhost:5177

# ------------------------------------------------------------------------------
# 5. BUSINESS & TAX COMPLIANCE DEFAULTS (India GST)
# ------------------------------------------------------------------------------
CURRENCY=INR
DEFAULT_GST_RATE_PERCENT=18.0
STORE_NAME="Unikart Retail & E-Commerce Enterprises"
STORE_GSTIN=29AABCT3518Q1ZV
STORE_ADDRESS="100 Feet Road, Indiranagar, Bengaluru, Karnataka - 560038"
STORE_STATE_CODE=29
